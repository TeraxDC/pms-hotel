# ==============================================================================
# hotelSJB - Configuración de Entorno de Producción y Desarrollo
# ==============================================================================

# ENTORNO Y PUERTO
NODE_ENV=production
PORT=3000

# CONEXIÓN A MYSQL (Instalado localmente en el Host del VPS)
# En el VPS con Docker, use 'host.docker.internal' o '172.17.0.1' para alcanzar el MySQL nativo del host.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=hotel_sjb_user
DB_PASSWORD=TuPasswordSeguraAqui123!
DB_DATABASE=hotel_sjb_db
DB_SYNCHRONIZE=false

# SEGURIDAD Y JWT
JWT_SECRET=hotel_sjb_ultra_secure_secret_key_change_in_production_2026
JWT_EXPIRES_IN=24h

# CORS Y DOMINIOS
# URL donde está alojado el frontend en cPanel
FRONTEND_URL=https://tudominio.com

# SUBIDAS DE ARCHIVOS
UPLOAD_DESTINATION=./uploads
MAX_FILE_SIZE=5242880
